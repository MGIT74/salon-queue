# ============================================================
#  Variables d'environnement de l'application.
#  UN fichier par environnement (test, production...) : ne JAMAIS
#  reutiliser les memes valeurs secretes entre deux environnements,
#  et ne jamais committer le vrai .env.
#  Sur xCloud : a saisir dans les reglages du site (le deploiement
#  fait un "git reset --hard", un .env televerse a la main est efface).
# ============================================================

# --- Base MySQL/MariaDB (propre a CET environnement) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=salon
DB_PASSWORD=
DB_NAME=salon_queue

# --- Port d'ecoute du serveur ---
PORT=3000

# --- Cle de chiffrement des mots de passe SMTP stockes en base ---
# OBLIGATOIRE en production. A generer une seule fois :
#     openssl rand -hex 32
# La CONSERVER dans un gestionnaire de mots de passe : la perdre ou la
# changer rend illisibles tous les mots de passe SMTP deja enregistres (il
# faut alors les ressaisir). Si elle est absente, l'application derive une
# cle du mot de passe de la base : changer ce mot de passe casserait alors
# aussi ces secrets.
SETTINGS_ENCRYPTION_KEY=

# --- Mot de passe du super administrateur (page /super-admin) ---
# Different sur chaque environnement. Sans lui, la page super admin refuse
# toute connexion.
SUPER_ADMIN_PASSWORD=

# --- Optionnel : assistant IA du dashboard (n8n) ---
# N8N_CHAT_WEBHOOK_URL=
# AUTOMATION_API_KEY=

# --- NE PAS DEFINIR EN PRODUCTION ---
# Raccourcit l'attente d'un paiement carte (110 s par defaut). Sert
# uniquement aux tests automatiques (tests/caisse).
# TPE_CHARGE_WAIT_MS=
