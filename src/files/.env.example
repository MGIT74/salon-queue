# Copiez ce fichier vers .env puis renseignez les valeurs de votre TPE.
# Le fichier .env est ignoré par Git : ne le validez jamais avec de vraies données.
PORT=3000

# Adresse réseau fixe et port d'écoute du TPE Nepting / HiPay.
NEPTING_TPE_HOST=192.168.1.50
NEPTING_TPE_PORT=8888

# Identifiants de caisse fournis/configurés par Nepting / HiPay.
NEPTING_CASH_REGISTER_ID=REMPLACER_PAR_12_CARACTERES
NEPTING_CASH_REGISTER_NUMBER=01

# À confirmer avec Nepting pour le terminal déployé.
NEPTING_PROTOCOL_VERSION=0300

# Délais réseau, en millisecondes.
NEPTING_CONNECT_TIMEOUT_MS=5000
NEPTING_RESPONSE_TIMEOUT_MS=60000
NEPTING_FRAMING_STRATEGY=idle
NEPTING_IDLE_TIMEOUT_MS=800
